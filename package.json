{
  "name": "@softwarestartups/gdrivescope",
  "version": "0.1.0",
  "description": "Bun-native TypeScript CLI for indexing, searching, and downloading Google Drive",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "gdrivescope": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "!build/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "start": "bun run build/index.js",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "lint": "bunx biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun test",
    "postinstall": "bun run scripts/patches/apply-kreuzberg-wasm-bundler.ts",
    "prepare": "lefthook install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftwareStartups/gdrivescope.git"
  },
  "bugs": {
    "url": "https://github.com/SoftwareStartups/gdrivescope/issues"
  },
  "homepage": "https://github.com/SoftwareStartups/gdrivescope#readme",
  "keywords": [
    "google-drive",
    "cli",
    "semantic-search",
    "ai",
    "bun",
    "typescript"
  ],
  "author": "SoftwareStartups",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@googleapis/drive": "^20.1.0",
    "@kreuzberg/node": "^4.8.5",
    "@kreuzberg/wasm": "^4.8.5",
    "google-auth-library": "^10.6.2",
    "graphology": "^0.26.0",
    "graphology-operators": "^1.6.1",
    "graphology-traversal": "^0.3.1",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "smol-toml": "^1.6.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/bun": "^1.3.12",
    "lefthook": "2.1.5",
    "typescript": "6.0.2"
  }
}
